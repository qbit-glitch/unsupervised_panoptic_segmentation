# Plan A (P0-P4 semantic aux-loss) machine override: santosh@100.93.203.100,
# 2x GTX 1080 Ti (11 GB each).
#
# Santosh is VRAM-constrained; bs=1/accum=16 is mandatory for Plan A's
# 640x1280 crop with DINOv3 ViT-B/16 frozen + Cascade Mask R-CNN.
# This matches what the canonical Plan A P0 yaml already defaults to,
# but we still set it here explicitly so the launcher is fully declarative.
#
# Env activation (run BEFORE invoking the launcher):
#   conda activate cups

DATA.ROOT=/media/santosh/Kuldeep/panoptic_segmentation/datasets/cityscapes/
DATA.ROOT_VAL=/media/santosh/Kuldeep/panoptic_segmentation/datasets/cityscapes/
DATA.ROOT_PSEUDO=/media/santosh/Kuldeep/panoptic_segmentation/datasets/cityscapes/cups_pseudo_labels_depthpro_tau020/

TRAINING.BATCH_SIZE=1
TRAINING.ACCUMULATE_GRAD_BATCHES=16

SYSTEM.NUM_WORKERS=2

LOG_ROOT=/home/santosh/experiments/stage2_P_passes
