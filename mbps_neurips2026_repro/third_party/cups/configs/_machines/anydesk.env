# Plan A (P0-P4 semantic aux-loss) machine override: Anydesk RTX A6000 48GB.
#
# Sourced by scripts/run_stage2_P_passes.sh. Each KEY=VALUE line becomes
# a pair of yacs CLI overrides ("KEY VALUE") appended to refs/cups/train.py,
# except LOG_ROOT which is consumed by bash to build SYSTEM.LOG_PATH.
#
# Plan A uses the standard CUPS Cascade Mask R-CNN + DINOv3 ViT-B/16 (frozen)
# pipeline (refs/cups/train.py). P0 baseline crop is 640x1280 (1.56x pixels
# of Plan B's 512x1024), so we stay at bs=2/accum=8 (eff=16) to keep VRAM
# under ~38 GB even after auxiliary STEGO/GatedCRF terms activate in P2/P4.
# Bump to bs=4/accum=4 only after P0 VRAM is measured < 20 GB.
#
# Env activation (run BEFORE invoking the launcher):
#   module load gcc-9.3.0
#   source ~/umesh/ups_env/bin/activate

DATA.ROOT=/home/cvpr_ug_5/umesh/datasets/cityscapes/
DATA.ROOT_VAL=/home/cvpr_ug_5/umesh/datasets/cityscapes/
DATA.ROOT_PSEUDO=/home/cvpr_ug_5/umesh/datasets/cityscapes/cups_pseudo_labels_depthpro_tau020/

TRAINING.BATCH_SIZE=2
TRAINING.ACCUMULATE_GRAD_BATCHES=8

SYSTEM.NUM_WORKERS=4

# LOG_ROOT is consumed by the bash launcher -- not by yacs.
LOG_ROOT=/home/cvpr_ug_5/umesh/experiments/stage2_P_passes
